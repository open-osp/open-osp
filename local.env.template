
BACKUP_BUCKET="openosp"

# Optional backup settings (see doc/backup-process.md).
## Dedicated read-only database user for backups. Defaults to root (MYSQL_ROOT_PASSWORD) when unset.
## The db container reads this file, so recreate it after changing these: docker compose up -d db
# BACKUP_DB_USER=backup
# BACKUP_DB_PASSWORD=
## healthchecks.io-style URLs pinged on success, or <url>/fail on failure.
# BACKUP_HEALTHCHECK_URL=
# HDC_HEALTHCHECK_URL=
## Smallest dump size in bytes accepted as a successful backup.
# BACKUP_MIN_BYTES=10240
## Disk space (MB) that must stay free after a dump is written, for MySQL and the OS.
# BACKUP_MIN_FREE_MB=2048
## Backup target for --efs. Must be a mount point unless BACKUP_EFS_REQUIRE_MOUNT=0.
# BACKUP_EFS_ROOT=/srv/efs

OSCAR_TREEISH=""
OSCAR_REPO=""

# Settings for the Oscar Login page see /doc/Oscar_login_customization.md for details.

## HTML link to the support provider website.
SUPPORT_LINK="https://openosp.ca"

## Sub text for the support provider. such as telephone or email.
SUPPORT_TEXT="techsupport@openosp.ca <br /> +1 (604) 677-8613<br /><a target=\"_blank\" style=\"color:blue;text-decoration:underline;\" href=\"https://support.openosp.ca\">Help Desk</a>"

## Full name or title of the support provider.
SUPPORT_NAME=

